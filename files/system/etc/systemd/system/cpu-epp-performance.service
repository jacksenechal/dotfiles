[Unit]
Description=Set CPU energy performance preference to "performance"
Documentation=https://docs.kernel.org/admin-guide/pm/amd-pstate.html
# Skip cleanly on hosts without amd-pstate-epp / intel_pstate HWP.
ConditionPathExists=/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference
After=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
# Deliberately NOT RemainAfterExit: the unit must go inactive so the sleep
# targets below can start it again, since EPP resets to firmware default on resume.
ExecStart=/bin/sh -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do [ -w "$f" ] && echo performance > "$f"; done; exit 0'

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
