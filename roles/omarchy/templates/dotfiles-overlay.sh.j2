#!/usr/bin/env bash
# Managed by the dotfiles `omarchy` role - regenerated by the playbook, do not
# edit here. Runs from ~/.config/omarchy/hooks/post-update.d/ after migrations.
#
# Omarchy rewrites its own config files during updates, and most of those
# rewrites use `mv`, which replaces the file rather than writing through it. If
# that drops the one line linking in an overlay, the overlay silently stops
# loading. This re-adds any missing line. It only ever appends, so it cannot
# destroy configuration.

set -uo pipefail

assert_include() {
  local name=$1 file=$2 comment=$3 line=$4

  # Absent base config means the app is not installed here. Not an error.
  [[ -f $file ]] || return 0
  grep -Fqx -- "$line" "$file" && return 0

  printf '\n%s re-added by the dotfiles overlay hook on %s\n%s\n' \
    "$comment" "$(date -I)" "$line" >>"$file"
  echo "overlay: re-asserted the $name include in $file"
}

check_symlink() {
  local target=$1
  [[ -e $target ]] || return 0
  [[ -L $target ]] && return 0
  echo "overlay: WARNING $target is no longer a symlink into the dotfiles repo." >&2
  echo "overlay:          Edits there are not tracked. Re-run the dotfiles playbook." >&2
}

{% for entry in omarchy_overlay_includes %}
assert_include {{ entry.name | quote }} "$HOME/{{ entry.path }}" {{ entry.comment | quote }} {{ entry.line | quote }}
{% endfor %}

{% for target in omarchy_overlay_symlink_checks %}
check_symlink "$HOME/{{ target }}"
{% endfor %}

exit 0
