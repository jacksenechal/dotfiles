# Managed by dotfiles roles/power (see roles/power/defaults).
#
# suspend-then-hibernate: sleep in s2idle, then write RAM to /swap/swapfile and
# power off after HibernateDelaySec on battery, or earlier if systemd's battery
# estimate says the pack would run flat first (systemd-sleep.conf(5)).
[Sleep]
HibernateDelaySec={{ power_hibernate_delay }}
HibernateOnACPower={{ 'yes' if power_hibernate_on_ac else 'no' }}
